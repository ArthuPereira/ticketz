# Copie para .env (cp .env.example .env). O .env NÃO vai para o git.
# O docker compose lê este arquivo sozinho e troca os ${VAR} do docker-compose.yml.

# --- Usadas pelo docker-compose.yml / Terraform local ---
AWS_REGION=us-east-1
MINISTACK_HOST=localhost
DB_NAME=appdb
DB_USER=appuser
DB_PASSWORD=app_password_local

# --- Para a SUA aplicação (o compose não usa; carregue no seu app) ---
# Os SDKs da AWS (boto3, SDK v3 do JS, etc.) leem esta variável e passam a
# falar com o emulador sem mudar código. Na nuvem você simplesmente não define.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1

# --- Conexões e serviços da aws
S3_BUCKET=ticketz-files-local
S3_BUCKET_BANNERS=ticketz-files-local
S3_BUCKET_TICKETS=ticketz-files-local
DYNAMODB_TABLE=ticketz-action-logs
# --- Banco de Dados e Cache (containers locais) ---
DB_HOST=localhost
DB_PORT=5432
CACHE_HOST=localhost
CACHE_PORT=6379

# --- Preencha com o resultado de: docker compose run --rm terraform output ---
SNS_TOPIC_ARN=
SQS_QUEUE_URL=

# --- Auth & JWT ---
SECRET_KEY=change-this-in-production-use-a-strong-secret-key-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
ALLOW_ORGANIZER_SIGNUP=true