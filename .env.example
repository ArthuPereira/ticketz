# Copie para .env (cp .env.example .env). O .env NÃO vai para o git.

# --- Banco de Dados Relacional (PostgreSQL) ---
DB_NAME=appdb
DB_USER=appuser
DB_PASSWORD=app_password_local
DB_HOST=localhost
DB_PORT=5432
DATABASE_URL="postgresql+asyncpg://appuser:app_password_local@localhost:5432/appdb"

# --- Cache em Memória (Valkey) ---
CACHE_HOST=localhost
CACHE_PORT=6379
REDIS_URL="redis://localhost:6379/0"

# --- Mensageria Assíncrona (RabbitMQ) ---
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_URL="amqp://guest:guest@localhost:5672/"
RABBITMQ_EXCHANGE=ticketz.tickets
RABBITMQ_QUEUE=ticketz.ticket.processing
RABBITMQ_DLQ=ticketz.ticket.processing.dlq
RABBITMQ_MAX_RETRIES=3
WORKER_DELAY_SECONDS=0

# --- Object Storage S3-Compatible (Garage) ---
S3_PORT=3900
GARAGE_ADMIN_PORT=3903
S3_ENDPOINT_URL=http://localhost:3900
S3_PUBLIC_ENDPOINT_URL=http://localhost:3900
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=GK0102030405060708090a0b0c
S3_SECRET_ACCESS_KEY=0102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f20
S3_BUCKET=ticketz-files-local
S3_BUCKET_BANNERS=ticketz-files-local
S3_BUCKET_TICKETS=ticketz-files-local

# --- Banco de Documentos / Auditoria (DynamoDB Local) ---
DYNAMODB_PORT=8001
DYNAMODB_ENDPOINT_URL=http://localhost:8001
DYNAMODB_TABLE=ticketz-action-logs
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# --- Auth & JWT ---
SECRET_KEY="ticketz-super-secret-key-change-in-production-min-32-chars"
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
ALLOW_ORGANIZER_SIGNUP=true
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000
